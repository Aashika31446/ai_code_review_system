# ==============================================================================
# AI-Assisted Code Review System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize the values before running the application:
#   cp .env.example .env
# ==============================================================================

# Database
DATABASE_URL=postgresql://postgres:password@db:5432/code_review_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=code_review_db

# JWT
SECRET_KEY=your-secret-key-change-this-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
