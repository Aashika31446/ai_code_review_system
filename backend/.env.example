# Database connection (PostgreSQL / SQLite)
DATABASE_URL=postgresql://postgres:password@localhost:5432/code_review_db
# For SQLite local dev: sqlite+aiosqlite:///./code_review.db

# Security & JWT Token signing
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# AI Provider Settings ("gemini" or "openai")
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
